Leetcode: 1588

class Solution {
    public int sumOddLengthSubarrays(int[] arr) {
        int total = 0;
        for (int start = 0; start < arr.length; start++) {
            int sum = 0; 
            for (int end = start; end < arr.length; end++) {
                sum += arr[end];
                if ((end - start + 1) % 2 == 1) {
                    total += sum;
                }
            }
        }
        return total;
    }
}
