import java.util.*;
class Solution { 
    public int[] findEvenNumbers(int[] digits) {
        List<Integer> list = new ArrayList<>();
        for (int i = 100; i <= 998; i += 2) {
            int[] count = new int[10];
            int temp = i;
            count[temp % 10]++;
            temp /= 10;
            count[temp % 10]++;
            temp /= 10;
            count[temp % 10]++;
            int[] available = new int[10];
            for (int d : digits) {
                available[d]++;
            }
            boolean ok = true;
            for (int k = 0; k < 10; k++) {
                if (count[k] > available[k]) {
                    ok = false;
                    break;
                }
            }
            if (ok) {
                list.add(i);
            }
        }
        int[] result = new int[list.size()];
        for (int i = 0; i < list.size(); i++) {
            result[i] = list.get(i);
        }
        return result;
    }
}
