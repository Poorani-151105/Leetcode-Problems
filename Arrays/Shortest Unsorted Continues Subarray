import java.util.Arrays;
class Solution {
    public int findUnsortedSubarray(int[] nums) {
        int[] sorted = nums.clone();
        Arrays.sort(sorted);
        int start = 0;
        int end = nums.length - 1;
        while (start < nums.length && nums[start] == sorted[start]) {
            start++;
        }
        while (end >= 0 && nums[end] == sorted[end]) {
            end--;
        }
        if (start > end) {
            return 0;
        }
        return end - start + 1;
    }
}
