Leetcode: 867

class Solution {
    public int[][] transpose(int[][] a) {
        int rows = a.length;
        int cols = a[0].length;

        int[][] result = new int[cols][rows];

        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
                result[j][i] = a[i][j];
            }
        }
        return result;
    }
}
