Leetcode: 2319

class Solution {
    public boolean checkXMatrix(int[][] arr) {
        for(int i=0; i<arr.length; i++){
            for(int j=0; j<arr[i].length;j++){
                if(i==j || i+j == arr.length-1){
                    if(arr[i][j] == 0){
                        return false;
                    }
                }
                else{
                    if(arr[i][j] != 0){
                        return false;
                    }
                }
            }
        }
        return true;
    }
}
